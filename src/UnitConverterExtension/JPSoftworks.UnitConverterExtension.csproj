<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>JPSoftworks.UnitConverterExtension</RootNamespace>
    <AssemblyName>$(CmdPalExtensionAssemblyName)</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PackageManifestPath>$(CmdPalPackageManifest)</PackageManifestPath>

    <TargetFramework>$(CmdPalTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(CmdPalTargetPlatformMinVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(CmdPalTargetPlatformMinVersion)</SupportedOSPlatformVersion>
    <!-- Use installed SDK metadata even when the target SDK version is not installed. -->
    <CsWinRTWindowsMetadata>sdk</CsWinRTWindowsMetadata>
    <RuntimeIdentifiers>$(CmdPalRuntimeIdentifiers)</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>

    <PublishProfile Condition="'$(_IsPublishing)' == 'true'">win-$(Platform).pubxml</PublishProfile>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <LangVersion>preview</LangVersion>

    <Company>Jiri Polasek</Company>
    <Copyright>(c) Jiri Polasek</Copyright>
    <NeutralLanguage>$(CmdPalDefaultLanguage)</NeutralLanguage>
    <Product>Unit Converter for Command Palette</Product>
    <AssemblyTitle>Unit Converter for Command Palette</AssemblyTitle>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\App.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\AppLogo.png;Assets\AppLogo.svg;Assets\Icons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JPSoftworks.CommandPalette.Extensions.Toolkit" />
    <PackageReference Include="Microsoft.CommandPalette.Extensions" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Shmuelie.WinRTServer" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnitConverterCore\JPSoftworks.UnitConverter.Core.csproj" />
    <InternalsVisibleTo Include="JPSoftworks.UnitConverterExtension.AppTests" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Serilog" />
  </ItemGroup>

  <PropertyGroup>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">false</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>

    <!-- When publishing trimmed, make sure to treat trimming warnings as build errors -->
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <!-- UnitsNet 5's unused reflective conversion registry emits IL2075; retain the warning. -->
    <WarningsNotAsErrors Condition="'$(PublishAot)' == 'true'">$(WarningsNotAsErrors);IL2075</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <!-- Keep trim and AOT analysis enabled for development builds. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <Target Name="UpdateVersionFromPackageManifest" BeforeTargets="BeforeBuild">
    <XmlPeek XmlInputPath="$(PackageManifestPath)" Query="/appx:Package/appx:Identity/@Version" Namespaces="&lt;Namespace Prefix='appx' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;">
      <Output TaskParameter="Result" PropertyName="appxManifestVersion" />
    </XmlPeek>

    <Message Importance="High" Text="Set project version to match Appx manifest: $(appxManifestVersion)" />

    <PropertyGroup>
      <Version>$(appxManifestVersion)</Version>
    </PropertyGroup>
  </Target>


  <Target Name="KillRunningExecutable" BeforeTargets="Build;Deploy;Publish" Condition="'$(SkipKillRunningExecutable)' != 'true'">
    <Exec Command="powershell -NoProfile -NonInteractive -Command &quot;Get-Process | Where-Object ProcessName -EQ '$(AssemblyName)' | Stop-Process -Force -ErrorAction Stop&quot;" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
